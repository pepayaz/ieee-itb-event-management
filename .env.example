# Koneksi PostgreSQL dari Neon.
# Ambil dari dashboard Neon > Connection Details > Connection string.
# Pastikan mode "Pooled connection" untuk DATABASE_URL.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Koneksi langsung (non-pooled), dipakai Prisma saat menjalankan migration.
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Secret untuk menandatangani JWT. WAJIB diganti dengan string acak yang panjang.
# Generate dengan: openssl rand -base64 32
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Kredensial admin awal, dipakai oleh script seed (prisma/seed.ts).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-password-ini"
